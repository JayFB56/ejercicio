<script>
const $ = (id) => document.getElementById(id);

function log(msg) {
  const c = $("console");
  const t = new Date().toLocaleTimeString();
  c.textContent += `[${t}] ${msg}\n`;
  c.scrollTop = c.scrollHeight;
}

async function api(url) {
  const r = await fetch(url, {cache: "no-store"});
  const txt = await r.text();
  return txt;
}

function showPanel(mode) {
  const map = {
    STOP: null,
    SENSOR: null,
    MANUAL: "panelManual",
    DIRECT: "panelDirect",
    RAMP: "panelRamp",
    LINE: "panelLine"
  };
  document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));
  if (map[mode]) $(map[mode]).classList.add("active");

  document.querySelectorAll(".mode-btn").forEach(b => {
    b.classList.toggle("active", b.dataset.mode === mode);
  });
}

function setLed(id, v) {
  const e = $(id);
  e.classList.toggle("on", Number(v) === 1);
}

function safeNum(v, def=0) {
  const n = Number(v);
  return Number.isFinite(n) ? n : def;
}

async function refreshState() {
  try {
    const r = await fetch("/api/state", {cache: "no-store"});
    const s = await r.json();

    $("wifiIp").textContent = s.wifi.ip;
    $("wifiClients").textContent = s.wifi.clients;
    $("teleIp").textContent = s.wifi.ip;
    $("teleClients").textContent = s.wifi.clients;

    $("modeLabel").textContent = s.mode;
    $("algoLabel").textContent = s.algo;
    $("teleMode").textContent = s.mode;
    $("teleAlgo").textContent = s.algo;
    $("teleEna").textContent = s.direct.ena;
    $("teleEnb").textContent = s.direct.enb;
    $("teleRamp").textContent = s.ramp.running ? "ON" : "OFF";
    $("teleSensor").textContent = s.sensorActiveHigh ? "HIGH" : "LOW";

    $("sL").textContent = s.sensors.l;
    $("sC").textContent = s.sensors.c;
    $("sR").textContent = s.sensors.r;

    setLed("ledL", s.sensors.l);
    setLed("ledC", s.sensors.c);
    setLed("ledR", s.sensors.r);

    $("errorVal").textContent = Number(s.error).toFixed(2);
    $("adjustVal").textContent = Number(s.adjust).toFixed(2);
    $("cmdL").textContent = s.motors.left;
    $("cmdR").textContent = s.motors.right;
    $("rampNow").textContent = s.ramp.current;

    $("baseLineSpeed").value = s.line.baseSpeed;
    $("maxLineAdjust").value = s.line.maxAdjust;
    $("classicGain").value = s.line.classicGain;
    $("sensorActiveHigh").checked = !!s.sensorActiveHigh;
    $("lineAlgo").value = (s.algo === "FUZZY") ? "fuzzy" : "classic";

    $("baseLineSpeedVal").textContent = s.line.baseSpeed;
    $("maxLineAdjustVal").textContent = s.line.maxAdjust;
    $("classicGainVal").textContent = s.line.classicGain;

    $("manualLeftSpeed").value = s.manual.leftSpeed;
    $("manualRightSpeed").value = s.manual.rightSpeed;
    $("manualLeftSpeedVal").textContent = s.manual.leftSpeed;
    $("manualRightSpeedVal").textContent = s.manual.rightSpeed;
    $("manualLeftDir").value = s.manual.leftForward ? "1" : "0";
    $("manualRightDir").value = s.manual.rightForward ? "1" : "0";

    $("in1").checked = !!s.direct.in1;
    $("in2").checked = !!s.direct.in2;
    $("in3").checked = !!s.direct.in3;
    $("in4").checked = !!s.direct.in4;
    $("ena").value = s.direct.ena;
    $("enb").value = s.direct.enb;
    $("enaVal").textContent = s.direct.ena;
    $("enbVal").textContent = s.direct.enb;

    $("rampMin").value = s.ramp.min;
    $("rampMax").value = s.ramp.max;
    $("rampStep").value = s.ramp.step;
    $("rampPeriod").value = s.ramp.period;

    $("stateLabel").textContent = s.stateText;
    $("stateLabel").className = s.stateClass;

    showPanel(s.mode);
  } catch (e) {
    $("stateLabel").textContent = "Sin conexión";
    $("stateLabel").className = "status-bad";
  }
}

document.querySelectorAll(".mode-btn").forEach(btn => {
  btn.addEventListener("click", async () => {
    const mode = btn.dataset.mode;
    await api(`/api/mode?m=${encodeURIComponent(mode)}`);
    log(`Modo -> ${mode}`);
    showPanel(mode);
  });
});

$("emergencyStop").addEventListener("click", async () => {
  await api("/api/stop");
  log("STOP de emergencia");
  showPanel("STOP");
});

$("manualLeftSpeed").addEventListener("input", () => $("manualLeftSpeedVal").textContent = $("manualLeftSpeed").value);
$("manualRightSpeed").addEventListener("input", () => $("manualRightSpeedVa
