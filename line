// ============================================================
// Difuso
// ============================================================
struct FuzzyTriangle {
  float a, b, c;

  float calculate(float x) const {
    if (x <= a || x >= c) return 0.0f;
    if (x == b) return 1.0f;
    if (x < b) return (x - a) / (b - a);
    return (c - x) / (c - b);
  }
};

